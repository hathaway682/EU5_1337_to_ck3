}

### Trade Market Map Icon
flowcontainer = {
	name = "trade_market_map_icon"
	datacontext = "[TradeMarketIcon.GetTradeMarket]"
	widgetanchor = bottom|hcenter
	ignoreinvisible = yes
	direction = vertical
	allow_outside = yes
	scale = 0.95

	state = {
		name = detail_in
		using = Animation_FadeIn_Quick
		trigger_when = "[TradeMarketIcon.ShouldShowDetails]"
	}

	state = {
		name = detail_out
		using = Animation_FadeOut_Quick
		trigger_when = "[Not( TradeMarketIcon.ShouldShowDetails)]"
	}

	background = {
		name = "draft_route_halo"
		visible = "[And( TradeMarketIcon.IsOnDraftRoute, Not( TradeMarketIcon.IsInNeedsMode ) )]"
		texture = "gfx/interface/component_masks/mask_glow.dds"
		using = Color_Bright_Yellow
		margin = { 25 11 }
		margin_top = 15
		alpha = 0.5
	}

	# The distribution card is much taller than the profit one, so it needs a wider halo to read.
	# Match profit: glow whenever on draft in needs mode (no zoom gate).
	background = {
		name = "draft_route_halo_distribution"
		visible = "[And( TradeMarketIcon.IsOnDraftRoute, TradeMarketIcon.IsInNeedsMode )]"
		texture = "gfx/interface/component_masks/mask_glow.dds"
		using = Color_Bright_Yellow
		margin = { 55 30 }
		margin_top = 34
		alpha = 0.5
	}

	flowcontainer = {
		name = "trade_opportunities"
		visible = "[Not( IsGameViewOpen( 'trade_route_planner' ) )]"
		parentanchor = hcenter
		ignoreinvisible = yes
		datamodel = "[TradeMarketIcon.GetTaskContracts]"

		item = {
			task_contract_location_icon = {
				visible = "[TaskContract.GetType.HasGroup( 'merchant_trade_opportunity_group' )]"
			}
		}
	}

	text_single = {
		name = "pick_first_market"
		visible = "[Or( And( TradeMarketIcon.IsInNeedsMode, Not( TradeMarketIcon.HasNeedsFirstMarket ) ), TradeMarketIcon.IsPickingProfitStartMarket )]"
		text = "TRADE_MAP_CARD_SET_AS_START"
		align = nobaseline
		default_format = "#I"
		snap_to_pixels = no
		parentanchor = hcenter
		margin_bottom = 5

		background = {
			margin = { 10 3 }
			using = Background_Area_Dark
			alpha = 0.9
			margin_bottom = -5

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_rough_edges.dds"
				blend_mode = alphamultiply
			}
		}
	}

	flowcontainer = {
		parentanchor = hcenter
		ignoreinvisible = yes
		direction = vertical

		trade_market_modifier_box = {}
		spacer = {
			size = { 0 2 }
		}

		trade_market_profit_card = {}

		trade_market_distribution_card = {}
	}

	icon = {

		visible = "[And3( TradeMarketIcon.HasFocusedGood, Or( TradeMarketIcon.IsFocusedGoodSurplus, TradeMarketIcon.IsFocusedGoodDeficit ), And( GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.IsInMarketsMapMode ) ) )]"
		texture = "gfx/interface/window_domiciles/domicile_location_map_pin_arrow.dds"
		parentanchor = hcenter
		size = { 80 22 }
		alpha = 0

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
		}
	}
}

### Head of Faith / Head of Rite Map Icon
container = {
	name = "religious_head_widget"
	datacontext = "[ReligiousHeadMapIcon.GetCharacter]"
	widgetanchor = center
	ignoreinvisible = yes
	allow_outside = yes
	scale = 1

	state = {
		name = "map_zoom_close"
		scale = 1
		duration = 0.25
		trigger_when = "[LessThan_int32( GetZoomLevel, '(int32)14' )]"
	}

	state = {
		name = "map_zoom_far"
		scale = 0.8
		duration = 0.25
		trigger_when = "[GreaterThan_int32( GetZoomLevel, '(int32)13' )]"
	}


	### Realm (primary title) CoA
	container = {
		visible = "[GetVariableSystem.Exists( 'faith_map_mode_religious_heads' )]"
		alpha = 0
		position = { 0 -60 }

		state = {
			name = "_show"
			alpha = 1
			duration = 0.4
		}

		state = {
			name = "_hide"
			alpha = 0
			duration = 0.4
			delay = 0.1
		}

		coa_realm_small_crown = {
			visible = "[LessThanOrEqualTo_int32( Character.GetPrimaryTitle.GetTierFrame, '(int32)4' )]"
		}
		coa_realm_medium_crown = {
			visible = "[GreaterThanOrEqualTo_int32( Character.GetPrimaryTitle.GetTierFrame, '(int32)5' )]"
		}

		### Faith Icon (heads of faith)
		religious_head_map_icon = {
			blockoverride "icon_visible" {
				visible = "[ReligiousHeadMapIcon.IsHeadOfFaith]"
			}
			blockoverride "icon_datacontext" {
				datacontext = "[Character.GetFaith]"
			}
			blockoverride "icon_texture" {
				texture = "[Faith.GetIcon]"
			}
			blockoverride "icon_tooltip" {
				tooltipwidget = { faith_tooltip = {} }
			}
		}

		### Rite Icon (heads of rite only)
		religious_head_map_icon = {
			blockoverride "icon_visible" {
				visible = "[Not( ReligiousHeadMapIcon.IsHeadOfFaith )]"
			}
			blockoverride "icon_datacontext" {
				datacontext = "[Character.GetRite]"
			}
			blockoverride "icon_texture" {
				texture = "[Rite.GetIcon]"
			}
			blockoverride "icon_tooltip" {
				tooltipwidget = { rite_tooltip = {} }
			}

		}
	}
}
