### Holy Site
flowcontainer = {
	name = "holy_site_widget"
	widgetanchor = center
	datacontext = "[HolySiteIcon.GetHolySiteItem]"
	datacontext = "[HolySiteItem.GetHolySite]"
	direction = vertical

	ignoreinvisible = yes

	button_normal = {
		parentanchor = hcenter

		visible = "[Not( GetVariableSystem.Exists( 'faith_map_mode_religious_heads' ) )]"

		background = {
			visible = "[And( HolySiteItem.IsHeldByFaith, HolySiteItem.GetHolySite.IsActive )]"
			texture = "[HolySiteItem.GetFaith.GetIcon]"
			size = "[Select_CVector2f( HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ), '(CVector2f)60,60', '(CVector2f)40,40' )]"

			glow = {
				color = { 0.2 0.2 0.2 0.6 }
				glow_radius = 8
			}
		}

		background = {
			visible = "[And( HolySiteItem.IsHeldByFaith, Not( HolySiteItem.GetHolySite.IsActive ) )]"
			texture = "[HolySiteItem.GetFaith.GetIcon]"
			size = "[Select_CVector2f( HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ), '(CVector2f)60,60', '(CVector2f)40,40' )]"

			glow = {
				color = { 1 0.6 0.2 0.5 }
				glow_radius = 8
			}
		}

		background = {
			visible = "[Not( HolySiteItem.IsHeldByFaith )]"
			texture = "[HolySiteItem.GetFaith.GetIcon]"
			size = "[Select_CVector2f( HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ), '(CVector2f)60,60', '(CVector2f)40,40' )]"

			glow = {
				color = { 1 0.2 0.2 0.5 }
				glow_radius = 8
			}
		}

		name = "faith_icon"
		size = "[Select_CVector2f( HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ), '(CVector2f)60,60', '(CVector2f)40,40' )]"
		onclick = "[ToggleGameViewData( 'holy_site', HolySite.Self )]"
		tooltip = "FAITH_WINDOW_HOLY_SITE_TOOLTIP"
	}

	text_label_center = {
		parentanchor = hcenter
		visible = "[And( HolySiteItem.IsHeldByFaith, Not( GetVariableSystem.Exists( 'faith_map_mode_religious_heads' ) ) )]"
		text = "[HolySite.GetNameNoTooltip]"
		default_format = "#high"

		icon = {
			texture = "gfx/interface/icons/flat_icons/holy_site.dds"
			size = { 20 20 }
			parentanchor = left|vcenter
			widgetanchor = right|vcenter
			position = { -6 0 }

			modify_texture = {
				texture = "gfx/interface/colors/colors_textured.dds"
				blend_mode = add
				framesize = { 96 96 }
				frame = "[Select_int32( HolySiteItem.GetFaith.IsEminentHolySite( HolySiteItem.GetHolySite.Self ), '(int32)1', '(int32)4') ]"
			}

			glow = {
				color = { 0 0 0 1 }
				glow_radius = 6

				glow_generation_rules= {
					glow_alpha_mask = 0
					glow_blur_passes = 10
					glow_texture_downscale = 5.5f
					glow_ignore_inside_pixels = yes
				}
			}
		}
	}

	text_label_center = {
		parentanchor = hcenter
		visible = "[Nor( HolySiteItem.IsHeldByFaith, GetVariableSystem.Exists( 'faith_map_mode_religious_heads' ) )]"
		text = "[HolySite.GetNameNoTooltip]"
		default_format = "#medium"

		icon = {
			texture = "gfx/interface/icons/flat_icons/holy_site.dds"
			size = { 20 20 }
			parentanchor = left|vcenter
			widgetanchor = right|vcenter
			position = { -6 0 }

			modify_texture = {
				texture = "gfx/interface/colors/colors_textured.dds"
				blend_mode = add
				framesize = { 96 96 }
				frame = "[Select_int32( HolySiteItem.GetFaith.IsEminentHolySite( HolySiteItem.GetHolySite.Self ), '(int32)1', '(int32)4') ]"
			}

			glow = {
				color = { 0 0 0 1 }
				glow_radius = 6

				glow_generation_rules= {
					glow_alpha_mask = 0
					glow_blur_passes = 10
					glow_texture_downscale = 5.5f
					glow_ignore_inside_pixels = yes
				}
			}
		}
	}
}

