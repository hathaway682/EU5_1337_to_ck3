types MapIcons
{
	type trade_map_icon_hidden_good_entry = market_good_balance_cell {
		alwaystransparent = no

		tooltipwidget = {
			widget_trade_map_icon_balance_breakdown_tooltip = {
				datacontext = "[TradeMapIconGood.GetTradeGoodType]"
				datacontext = "[TradeMapIconGood.GetCategory]"
			}
		}

		blockoverride "balance_label" {
			alwaystransparent = yes
			text = "TRADE_MAP_CARD_HIDDEN_GOOD_NAME"
		}

		blockoverride "balance_value" {
			alwaystransparent = yes
			text = "[TradeMapIconGood.GetAmount|1^]"
			block "hidden_good_amount_format" {}
		}
	}

	type widget_trade_map_icon_hidden_goods_tooltip = widget {
		size = { 280 5 }
		using = DefaultTooltipBackground
		using = GeneralTooltipSetup
		alwaystransparent = no

		vbox = {
			margin = { 15 12 }
			spacing = 6
			layoutpolicy_horizontal = expanding
			resizeparent = yes

			text_multi = {
				autoresize = yes
				layoutpolicy_horizontal = expanding
				max_width = 250

				block "hidden_header" {}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				block "hidden_items" {}
			}
		}
	}

	type widget_trade_map_icon_balance_breakdown_tooltip = container {
		alwaystransparent = no

		widget_trade_good_balance_breakdown_tooltip = {
			visible = "[Not( TradeMapIconGood.IsCategory )]"

			blockoverride "building_needs_row" {
				market_good_balance_cell = {
					blockoverride "balance_label" {
						text = "MARKET_GOOD_BALANCE_BUILDING_NEEDS"
					}

					blockoverride "balance_value" {
						text = "TRADE_MAP_CARD_BUILDING_NEEDS_VALUE"
						default_format = "#trade_need"
					}
				}
			}

			blockoverride "unmet_needs_section" {
				market_good_balance_cell = {
					visible = "[GreaterThan_CFixedPoint( TradeMapIconGood.GetOwnHoldingsNeed, '(CFixedPoint)0' )]"
					blockoverride "balance_label" {
						text = "TRADE_MAP_CARD_NEED_IN_YOUR_HOLDINGS"
					}

					blockoverride "balance_value" {
						text = "[TradeMapIconGood.GetOwnHoldingsNeed|1^]"
						default_format = "#trade_need"
					}
				}
			}
		}

		widget_trade_map_icon_category_balance_tooltip = {
			visible = "[TradeMapIconGood.IsCategory]"
		}
	}

	type widget_trade_map_icon_category_balance_tooltip = container {
