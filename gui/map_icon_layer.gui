			expand = {}

			text_single = {
				name = "radiance"
				raw_text = "[Character.GetRadianceValueNoTooltip|V0]/[GetDefine( 'NMandala', 'MAX_RADIANCE' )|V0]"
				align = center|nobaseline
				fontsize_min = 12
				max_width = 50
			}
		}
		tooltip = "[Character.GetRadianceValueTooltip]"
