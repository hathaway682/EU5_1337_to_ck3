	# common icon type for religious heads
	type religious_head_map_icon = icon {
		block "icon_visible" {}
		block "icon_datacontext" {}
		parentanchor = bottom|right
		position = { 8 2 }
		size = { 35 35 }
		allow_outside = yes
		block "icon_texture" {}

		block "icon_tooltip" {}
		using = tooltip_se

		background = {
			using = Background_Area_Dark
			alpha = 0.8
			margin = { 6 6 }

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_circle.dds"
