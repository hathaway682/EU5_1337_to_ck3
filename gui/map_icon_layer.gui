	type trade_map_icon_good_chip = widget {
		size = { 24 24 }
		using = tooltip_es

		background = {
			texture = "gfx/interface/component_masks/mask_rough_edges.dds"
			spriteType = Corneredtiled
			spriteborder = { 10 10 }
			margin = { 3 3 }
			texture_density = 3

			block "chip_tint" {}
		}

		icon = {
			visible = "[Not( TradeMapIconGood.IsCategory )]"
			datacontext = "[TradeMapIconGood.GetTradeGoodType]"
			size = { 100% 100% }
			texture = "[TradeGoodType.GetSmallIcon]"

			glow = {
				visible = "[TradeMapIconGood.IsHighlighted]"
				glow_radius = 5
				using = Glow_Standard
				alpha = 0
				block "chip_glow_color"
				{
					using = Color_Bright_Yellow
				}
			}

			state = {
				name = a
				next = b
				glow_alpha = 1
				duration = 1
				trigger_on_create = yes
				using = Animation_Curve_Default
			}

			state = {
				name = b
				next = a
				glow_alpha = 0.8
				duration = 1
				using = Animation_Curve_Default
			}
		}

		icon = {
			visible = "[TradeMapIconGood.IsCategory]"
			datacontext = "[TradeMapIconGood.GetCategory]"
			size = { 100% 100% }
			texture = "[TradeGoodCategory.GetSmallIcon]"

			glow = {
				visible = "[TradeMapIconGood.IsHighlighted]"
				glow_radius = 5
				using = Glow_Standard
				alpha = 0
				block "chip_glow_color"
				{
					using = Color_Bright_Yellow
				}
			}

			state = {
				name = a
				next = b
				glow_alpha = 1
				duration = 1
				trigger_on_create = yes
				using = Animation_Curve_Default
			}

			state = {
				name = b
				next = a
				glow_alpha = 0.8
				duration = 1
				using = Animation_Curve_Default
			}
		}

		icon = {
			visible = "[TradeMapIconGood.IsReducedByExistingClaims]"
			parentanchor = bottom|right
			position = { 3 3 }
			size = { 13 13 }
			## TODO_GDP [TIT-76286]: This is the texture to change for entrepots
			texture = "gfx/interface/icons/flat_icons/distribution_route.dds"
			tooltip = "TRADE_MAP_CARD_REDUCED_BY_EXISTING_CLAIM"
			using = tooltip_es

			modify_texture = {
				texture = "gfx/interface/colors/blue.dds"
			}

			modify_texture = {
				texture = "gfx/interface/colors/white.dds"
				alpha = 0.05
			}

			glow = {
				color = { 0 0 0 0.8 }
				glow_radius = 3
				using = Glow_Standard
			}
		}

		icon = {
			visible = "[TradeMapIconGood.IsReducedByExploitativeMonopoly]"
			parentanchor = bottom|left
			position = { -3 3 }
			size = { 13 13 }
			texture = "gfx/interface/icons/trade/icon_trade_monopoly_exploitative.dds"
			tooltip = "TRADE_MAP_CARD_REDUCED_BY_EXPLOITATIVE_MONOPOLY"
			using = tooltip_es
		}

		tooltipwidget = {
			widget_trade_map_icon_balance_breakdown_tooltip = {
				datacontext = "[TradeMapIconGood.GetTradeGoodType]"
				datacontext = "[TradeMapIconGood.GetCategory]"
			}
		}
	}

	type trade_map_icon_goods_row = flowcontainer {
		ignoreinvisible = yes

		## TODO_GDP [TIT-76395]: placeholder indicator art, and the panel tints below want an art pass
		icon = {
			name = "row_indicator"
