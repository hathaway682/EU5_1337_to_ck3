	type trade_market_modifier_box = flowcontainer {
		direction = horizontal
		parentanchor = hcenter
		ignoreinvisible = yes
		visible = "[And( TradeMarketIcon.ShouldShowBanner, Or3( DataModelHasItems( TradeMarketIcon.GetPlayerMonopolies ), And( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.ShowEntrepotIcon ), Or( TradeMarketIcon.HasPlayerTradePost, GreaterThan_int32( GetDataModelSize( TradeMarketIcon.GetTimedModifiers ), '(int32)0' ) ) ) )]"

		background = {
			using = Background_Area_Dark
			margin = { 5 0 }
		}

		flowcontainer = {
			parentanchor = vcenter
			visible = "[DataModelHasItems( TradeMarketIcon.GetPlayerMonopolies )]"
			datamodel = "[TradeMarketIcon.GetPlayerMonopolies]"
			margin = { 4 4 }

			item = {
				widget_trade_monopoly_icon = {
					size = { 30 30 }
					using = tooltip_se
				}
			}
		}

		flowcontainer = {
			parentanchor = vcenter
			visible = "[And( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.ShowEntrepotIcon )]"
			margin = { 4 4 }

			icon = {
				texture = "gfx/interface/icons/trade/icon_entrepot.dds"
				size = { 30 30 }
				tooltip = "TRADE_MAP_ICON_ENTREPOT_TT"
				using = tooltip_se
			}
		}

		flowcontainer = {
			parentanchor = vcenter
			visible = "[TradeMarketIcon.HasPlayerTradePost]"
			margin = { 4 4 }

			icon = {
				size = { 30 30 }
				texture = "gfx/interface/icons/trade/icon_trade_post.dds"
				tooltip = "TRADE_MAP_ICON_TRADE_POST_TT"
				using = tooltip_se
			}
		}

		flowcontainer = {
			parentanchor = vcenter
			visible = "[DataModelHasItems( TradeMarketIcon.GetTimedModifiers )]"
			spacing = 2
			ignoreinvisible = yes
			margin = { 4 4 }

			flowcontainer = {
				ignoreinvisible = yes
				datamodel = "[DataModelFirst( TradeMarketIcon.GetTimedModifiers, '(int32)3' )]"
				spacing = 2
				item = {
					modifier_item_icon = {
						size = { 24 24 }
					}
				}
			}

			text_single = {
				visible = "[GreaterThan_int32( GetDataModelSize( TradeMarketIcon.GetTimedModifiers ), '(int32)3' )]"
				text = "[GetNumberAbove_int32( GetDataModelSize( TradeMarketIcon.GetTimedModifiers ), '(int32)3' )|=]"
				default_format = "#high"
				align = nobaseline
				snap_to_pixels = no
				using = tooltip_es

				tooltipwidget = {
					widget_trade_map_icon_hidden_goods_tooltip = {
						blockoverride "hidden_header"
						{
							text = "TRADE_MAP_CARD_HIDDEN_MODIFIERS_TT"
						}

						blockoverride "hidden_items"
						{
							datamodel = "[DataModelSkipFirst( TradeMarketIcon.GetTimedModifiers, '(int32)3' )]"
							item = {
								trade_map_icon_hidden_modifier_entry = {}
							}
						}
					}
				}
			}
		}
	}

	type trade_market_profit_card = widget {
		size = { 0 0 }
		parentanchor = hcenter
		visible = "[Not( TradeMarketIcon.IsInNeedsMode )]"

		vbox = {
			set_parent_size_to_minimum = yes
			ignoreinvisible = yes
			bottomtotop = yes

			widget = {
				size = { 180 70 }
				visible = "[And4( TradeMarketIcon.HasFocusedGood, TradeMarketIcon.IsFocusedGoodSurplus, Not( TradeMarketIcon.IsFocusedGoodDeficit ), And( GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.IsInMarketsMapMode ) ) )]"

				background = {
					using = Background_Area_Dark
					margin = { 8 2 }
					margin_top = 6
					color = { 0.14 0.16 0.15 0.7 }
					visible = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
				}

				background = {
					using = Background_Area_Dark
					margin = { 8 2 }
					margin_top = 0
					color = { 0.14 0.16 0.15 0.7 }
					visible = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
				}

				background = {
					visible = "[And( IsGameViewOpen( 'trade_route_planner' ), Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute ) )]"
					using = Background_Area_Dark
					margin = { 8 6 }
					margin_top = 6
					margin_bottom = -33
					color = { 0.14 0.16 0.15 0.7 }
				}
				background = {
					visible = "[And4( IsGameViewOpen( 'trade_route_planner' ), GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
					using = Background_Area_Dark
					margin = { 8 6 }
					margin_top = 0
					margin_bottom = -33
					color = { 0.14 0.16 0.15 0.7 }
				}

				state = {
					name = detail_in
					using = Animation_FadeIn_Standard
					size = { 155 70 }
					trigger_when = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
				}

				state = {
					name = detail_compact
					using = Animation_FadeIn_Standard
					size = { 110 70 }
					trigger_when = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
				}

				hbox = {
					name = "buy_info_panel"
					parentanchor = hcenter

					expand = {}
					flowcontainer_market_trade_info = {}
					expand = {}
				}
			}

			widget = {
				size = { 180 70 }
				visible = "[And4( TradeMarketIcon.HasFocusedGood, TradeMarketIcon.IsFocusedGoodDeficit, Not( TradeMarketIcon.IsFocusedGoodSurplus ), And( GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.IsInMarketsMapMode ) ) )]"

				background = {
					using = Background_Area_Dark
					margin = { 8 2 }
					margin_top = 6
					color = { 0.18 0.14 0.08 0.7 }
					visible = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
				}

				background = {
					using = Background_Area_Dark
					margin = { 8 2 }
					margin_top = 0
					color = { 0.18 0.14 0.08 0.7 }
					visible = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
				}

				background = {
					visible = "[And( IsGameViewOpen( 'trade_route_planner' ), Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute ) )]"
					using = Background_Area_Dark
					margin = { 8 6 }
					margin_top = 6
					margin_bottom = -33
					color = { 0.18 0.14 0.08 0.7 }
				}

				background = {
					visible = "[And4( IsGameViewOpen( 'trade_route_planner' ), GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
					using = Background_Area_Dark
					margin = { 8 6 }
					margin_top = 0
					margin_bottom = -33
					color = { 0.18 0.14 0.08 0.7 }
				}

				state = {
					name = detail_in
					using = Animation_FadeIn_Standard
					size = { 155 70 }
					trigger_when = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
				}

				state = {
					name = detail_compact
					using = Animation_FadeIn_Standard
					size = { 110 70 }
					trigger_when = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
				}

				hbox = {
					name = "sell_info_panel"
					parentanchor = hcenter

					expand = {}
					flowcontainer_market_sell_info = {}
					expand = {}
				}
			}

			# Both buy and sell: shared background, dual state visible when the focused good shows both buy and sell information
			widget = {
				size = { 180 150 }
				visible = "[And3( TradeMarketIcon.HasFocusedGood, And( TradeMarketIcon.IsFocusedGoodDeficit, TradeMarketIcon.IsFocusedGoodSurplus ), And( GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.IsInMarketsMapMode ) ) )]"

				background = {
					using = Background_Area_Dark
					margin = { 8 6 }
				}

				state = {
					name = detail_in
					using = Animation_FadeIn_Standard
					size = { 155 130 }
					trigger_when = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
				}

				state = {
					name = detail_compact
					using = Animation_FadeIn_Standard
					size = { 106 120 }
					trigger_when = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
				}

				vbox = {
					ignoreinvisible = yes
					spacing = 0
					margin_bottom = 3
					parentanchor = hcenter

					hbox = {
						name = "buy_info_panel_dual"
						layoutpolicy_horizontal = expanding

						expand = {}
						flowcontainer_market_trade_info = {
							margin_top = 8
						}
						expand = {}
					}

					expand = {}

					hbox = {
						layoutpolicy_horizontal = expanding

						spacer = {
							size = { 12 0 }
						}

						divider_light = {
							layoutpolicy_horizontal = expanding
							color = { 0.65 0.65 0.7 0.65 }
						}

						spacer = {
							size = { 12 0 }
						}

					}

					expand = {}

					hbox = {
						name = "sell_info_panel_dual"
						layoutpolicy_horizontal = expanding
						margin = { 0 5 }

						expand = {}
						flowcontainer_market_sell_info = {}
						expand = {}
					}
				}
			}

			widget = {
				name = "player_route_trades"
				size = { 180 40 }

				visible = "[And3( GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.HasPlayerRouteTrades )]"

				state = {
					name = detail_in
					using = Animation_FadeIn_Quick
					size = { 180 40 }
					trigger_when = "[TradeMarketIcon.ShouldShowDetails]"
				}

				state = {
					name = detail_out
					using = Animation_FadeOut_Quick
					size = { 180 0 }
					trigger_when = "[Not( TradeMarketIcon.ShouldShowDetails)]"
				}

				hbox = {
					margin = { 5 0 }

					hbox = {
						visible = "[TradeMarketIcon.HasPlayerRouteBuys]"
						using = tooltip_es
						name = "player_route_buys"
						spacing = 4

						background = {
							using = Background_Area_Dark
							margin = { 5 7 }
						}
						tooltip = "TRADE_MAP_CARD_PLAYER_ROUTE_BUYS_TT"
						using = tooltip_es

						icon = {
							size = { 24 24 }
							texture = "gfx/interface/icons/symbols/icon_arrow_down_blue.dds"
						}

						text_single = {
							text = "TRADE_MAP_CARD_BUY"
							align = nobaseline
							snap_to_pixels = no
						}

						flowcontainer = {
							spacing = 2

							datamodel = "[TradeMarketIcon.GetPlayerRouteBuys]"
							item = {
								icon = {
									size = { 35 35 }
									texture = "[TradeGoodType.GetSmallIcon]"
								}
							}
						}

					}

					hbox = {
						name = "player_route_sells"
						spacing = 5
						tooltip = "TRADE_MAP_CARD_PLAYER_ROUTE_SELLS_TT"

						visible = "[TradeMarketIcon.HasPlayerRouteSells]"
						using = tooltip_es

						background = {
							using = Background_Area_Dark
							margin = { 5 7 }
						}

						icon = {
							size = { 24 24 }
							texture = "gfx/interface/icons/symbols/icon_arrow_up.dds"
						}

						text_single = {
							text = "TRADE_MAP_CARD_SELL"
							align = nobaseline
							snap_to_pixels = no
						}

						hbox = {
							spacing = 2
							datamodel = "[TradeMarketIcon.GetPlayerRouteSells]"
							item = {
								icon = {
									size = { 35 35 }
									texture = "[TradeGoodType.GetSmallIcon]"
								}
							}
						}
					}
				}
			}

			widget = {
				minimumsize = { 180 36 }
				# Zoomed out with a focused good, only draft route stops and the home market keep their name
				visible = "[And( TradeMarketIcon.ShouldShowBanner, Or4( LessThan_int32( GetZoomLevel, '(int32)9' ), TradeMarketIcon.IsOnDraftRoute, ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), Not( And3( TradeMarketIcon.HasFocusedGood, GetPlayer.CanCreateProfitTradeRoutes, Not( TradeMarketIcon.IsInMarketsMapMode ) ) ) ) )]"
				using = Animation_ShowHide_Standard

				trade_market_name_banner = {
					name = "trade_market_name_below"
				}
			}
		}
	}


	type trade_market_distribution_card = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		ignoreinvisible = yes
		margin = { 7 0 }

		visible = "[TradeMarketIcon.IsInNeedsMode]"

		widget = {
			size = { 0 0 }
			parentanchor = hcenter

			vbox = {
				set_parent_size_to_minimum = yes
				ignoreinvisible = yes
				spacing = 0

				widget = {
					size = { 155 36 }
					minimumsize = { 155 0 }
					visible = "[TradeMarketIcon.ShouldShowBanner]"
					using = Animation_ShowHide_Standard

					trade_market_name_banner = {
						name = "market_name_slot"
					}
				}

				vbox = {
					ignoreinvisible = yes
					visible = "[And( Or( TradeMarketIcon.ShouldShowDetails, TradeMarketIcon.IsOnDraftRoute ), Or( TradeMarketIcon.HasAccessibleSurpluses, TradeMarketIcon.HasUnmetNeeds ) )]"

					background = {
						using = Background_Area_ExtraDark
						margin = { 3 3 }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						trade_map_icon_goods_row = {
							name = "trade_map_accessible_surpluses_tutorial_uses_this"
							layoutpolicy_horizontal = expanding
							visible = "[TradeMarketIcon.HasAccessibleSurpluses]"
							tooltip = "TRADE_MAP_CARD_SURPLUS_ROW_TT"

							blockoverride "row_indicator_art"
							{
								texture = "gfx/interface/icons/symbols/icon_arrow_up_blue.dds"
							}

							blockoverride "row_items"
							{
								datamodel = "[TradeMarketIcon.GetAccessibleSurpluses]"
								item = {
									trade_map_icon_good_chip = {
										blockoverride "chip_tint" {
											using = Color_Trade_Surplus_Dark
										}

										blockoverride "chip_glow_color" {
											using = Color_Trade_Surplus
										}
									}
								}
							}

							blockoverride "row_hidden_count"
							{
								visible = "[GreaterThan_int32( TradeMarketIcon.GetHiddenSurplusCount, '(int32)0' )]"
								text = "TRADE_MAP_CARD_HIDDEN_SURPLUS"
							}

							blockoverride "row_hidden_highlight_visible"
							{
								visible = "[TradeMarketIcon.HasHighlightedHiddenSurplus]"
							}

							blockoverride "row_hidden_highlight_color"
							{
								using = Color_Trade_Surplus
							}

							blockoverride "row_hidden_tooltip"
							{
								tooltipwidget = {
									widget_trade_map_icon_hidden_goods_tooltip = {
										blockoverride
										"hidden_header" {
											text = "TRADE_MAP_CARD_HIDDEN_SURPLUS_TT"
										}

										blockoverride "hidden_items"
										{
											datamodel = "[TradeMarketIcon.GetHiddenSurpluses]"
											item = {
												trade_map_icon_hidden_good_entry = {
													blockoverride "hidden_good_amount_format" {
														default_format = "#trade_surplus"
													}
												}
											}
										}
									}
								}
							}
						}

						expand = {}
					}

					trade_map_icon_goods_row = {
						name = "trade_map_unmet_needs_tutorial_uses_this"
						layoutpolicy_horizontal = expanding
						visible = "[TradeMarketIcon.HasUnmetNeeds]"
						tooltip = "TRADE_MAP_CARD_NEEDS_ROW_TT"

						blockoverride "row_indicator_art"
						{
							texture = "gfx/interface/icons/symbols/icon_arrow_up.dds"
							mirror = vertical
						}

						blockoverride "row_items"
						{
							datamodel = "[TradeMarketIcon.GetUnmetNeeds]"
							item = {
								trade_map_icon_good_chip = {
									blockoverride "chip_tint" {
										using = Color_Trade_Need_Dark
									}

									blockoverride "chip_glow_color" {
										using = Color_Trade_Need
									}
								}
							}
						}

						blockoverride "row_hidden_count"
						{
							visible = "[GreaterThan_int32( TradeMarketIcon.GetHiddenUnmetNeedCount, '(int32)0' )]"
							text = "TRADE_MAP_CARD_HIDDEN_NEEDS"
						}

						blockoverride "row_hidden_highlight_visible"
						{
							visible = "[TradeMarketIcon.HasHighlightedHiddenUnmetNeed]"
						}

						blockoverride "row_hidden_highlight_color"
						{
							using = Color_Trade_Need
						}

						blockoverride "row_hidden_tooltip"
						{
							tooltipwidget = {
								widget_trade_map_icon_hidden_goods_tooltip = {
									blockoverride
									"hidden_header" {
										text = "TRADE_MAP_CARD_HIDDEN_NEEDS_TT"
									}

									blockoverride "hidden_items"
									{
										datamodel = "[TradeMarketIcon.GetHiddenUnmetNeeds]"
										item = {
											trade_map_icon_hidden_good_entry = {
												blockoverride "hidden_good_amount_format" {
													default_format = "#trade_need"
												}
											}
										}
									}
								}
							}
						}
					}

					expand = {}
				}
			}
		}
	}

	type trade_map_icon_hidden_modifier_entry = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 5

		icon = {
			size = { 20 20 }
			texture = "[ModifierItem.GetIcon]"
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			align = nobaseline
			alwaystransparent = no
			text = "TRADE_MAP_CARD_HIDDEN_MODIFIER_ROW"
		}
	}

	# Buy/sell info for the Market Map Icon
	type flowcontainer_market_trade_info = flowcontainer {
		direction = vertical
		ignoreinvisible = yes

		datacontext = "[TradeMarketIcon.GetFocusedGood]"
		visible = "[TradeMarketIcon.HasFocusedGood]"

		flowcontainer = {
			name = "goods_amount_and_price"
			direction = vertical
			ignoreinvisible = yes
			parentanchor = hcenter
			margin = { 5 0 }

			block "trade_info_tooltip"
			{
				tooltip = "TRADE_MAP_CARD_DRAFT_ROUTE_BUY_TT"
			}

			flowcontainer = {
				name = "goods_amount"
				ignoreinvisible = yes
				parentanchor = hcenter

				icon = {
					texture = "gfx/interface/icons/symbols/icon_arrow_up.dds"
					mirror = vertical
					size = { 24 24 }
					block "trade_info_arrow_sell"
					{
						visible = no
					}
				}

				icon = {
					texture = "gfx/interface/icons/symbols/icon_arrow_up_blue.dds"
					size = { 24 24 }
					block "trade_info_arrow_buy"
					{
						visible = yes
					}
				}

				text_single = {
					visible = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
					using = Animation_ShowHide_Quick
					snap_to_pixels = no

					block "trade_info_verb"
					{
						text = "TRADE_MAP_CARD_BUY"
					}

					align = nobaseline
				}

				spacer = {
					visible = "[Or3( LessThan_int32( GetZoomLevel, '(int32)9' ), ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.IsOnDraftRoute )]"
					size = { 7 0 }
				}

				spacer = {
					visible = "[And3( GreaterThan_int32( GetZoomLevel, '(int32)8' ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.IsOnDraftRoute ) )]"
					size = { 2 0 }
				}

				flowcontainer = {
					spacing = 2
					ignoreinvisible = yes

					icon = {
						datacontext = "[TradeMarketIcon.GetFocusedGood]"
						size = { 24 24 }
						texture = "[TradeGoodType.GetSmallIcon]"
						parentanchor = vcenter
					}

					text_single = {
						block "trade_info_amount"
						{
							text = "TRADE_MAP_CARD_BUY_AMOUNT"
						}

						align = nobaseline
						parentanchor = vcenter
						snap_to_pixels = no
					}

					icon = {
						block "trade_info_capacity_limited"
						{
							visible = "[And( TradeMarketIcon.IsBuyLimitedByCapacityForFocusedGood, LessThan_int32( GetZoomLevel, '(int32)9' ) )]"
						}
						using = Animation_ShowHide_Quick

						size = { 20 20 }
						texture = "gfx/interface/icons/trade/icon_trade_capacity.dds"
						parentanchor = vcenter
					}

					alert_icon = {
						block "trade_info_other_route_warning"
						{
							visible = "[TradeMarketIcon.IsFocusedGoodBoughtOnOtherPlayerRoute]"
						}

						size = { 20 20 }
						parentanchor = vcenter
						tooltip = "TRADE_MAP_CARD_OTHER_ROUTE_WARNING_TT"
					}
				}
			}

			spacer = {

				size = { 0 5 }
			}

			flowcontainer = {
				name = "per_unit_price"
				block "market_share_datacontext"
				{
					datacontext = "[TradeMarketIcon.GetBuyShareForFocusedGood]"
				}
				ignoreinvisible = yes
				parentanchor = hcenter
				spacing = 2
				using = tooltip_es

				block "per_unit_price_tt"
				{
					tooltip = "TRADE_MARKET_MAP_ICON_BUY_PER_UNIT_PRICE_TT"
				}

				icon = {
					name = "icon_gold"
					size = { 24 24 }
					texture = "gfx/interface/icons/icon_gold.dds"
					parentanchor = vcenter
					alwaystransparent = yes
				}

				text_single = {
					block "per_unit_price_text"
					{
						text = "[TradeMarketIcon.GetBuyPriceForFocusedGood|V3]"
					}

					align = nobaseline
					parentanchor = vcenter
					alwaystransparent = yes
					snap_to_pixels = no
				}

				spacer = {
					visible = "[TradeMarketShare.IsContested]"
					size = { 4 0 }
				}

				flowcontainer = {
					name = "market_markers"
					visible = "[LessThan_int32( GetZoomLevel, '(int32)9' )]"
					using = Animation_ShowHide_Quick
					parentanchor = top
					ignoreinvisible = yes
					spacing = 5

					flowcontainer_trade_market_share_pie = {
						name = "competition"
						visible = "[TradeMarketShare.IsContested]"
						parentanchor = vcenter
					}

					flowcontainer = {
						name = "entrepot"
						parentanchor = vcenter
						visible = "[TradeMarketIcon.ShowEntrepotIcon]"

						tooltip = "TRADE_MAP_ICON_ENTREPOT_TT"

						background = {
							using = Background_Area_Dark
							alpha = 0.5
						}

						## TODO_GDP [TIT-76286]: This is the texture to change for entrepots
						icon = {
							size = { 24 24 }
							texture = "gfx/interface/icons/trade/icon_entrepot.dds"
							parentanchor = vcenter
						}
					}
				}
			}
		}
	}

	type flowcontainer_market_sell_info = flowcontainer_market_trade_info {
		blockoverride "per_unit_price_text"
		{
			text = "[TradeMarketIcon.GetSellPriceForFocusedGood|V3]"
		}

		blockoverride "per_unit_price_tt"
		{
			tooltip = "TRADE_MARKET_MAP_ICON_SELL_PER_UNIT_PRICE_TT"
		}

		blockoverride "trade_info_verb"
		{
			text = "TRADE_MAP_CARD_SELL"
		}

		blockoverride "trade_info_amount"
		{
			text = "TRADE_MAP_CARD_SELL_AMOUNT"
		}

		blockoverride "trade_info_other_route_warning"
		{
			visible = "[TradeMarketIcon.IsFocusedGoodSoldOnOtherPlayerRoute]"
		}

		blockoverride "trade_info_capacity_limited"
		{
			visible = "[And( TradeMarketIcon.IsSellLimitedByCapacityForFocusedGood, LessThan_int32( GetZoomLevel, '(int32)9' ) )]"
		}

		blockoverride "trade_info_tooltip"
		{
			tooltip = "TRADE_MAP_CARD_DRAFT_ROUTE_SELL_TT"
		}

		blockoverride "trade_info_arrow_sell"
		{
			visible = yes
		}

		blockoverride "trade_info_arrow_buy"
		{
			visible = no
		}

		blockoverride "market_share_datacontext"
		{
			datacontext = "[TradeMarketIcon.GetSellShareForFocusedGood]"
		}
	}

	type trade_market_name_banner = hbox {
		ignoreinvisible = yes

		# Priority: entrepot > home > buy > sell > default green
		# TODO_CODE TIT-80021: Move market banner color selection (entrepot > home > buy > sell > default) into CTradeMarketMapIcon helpers so these visible chains can be short bindings (e.g. ShowBuyBanner / GetBannerType).
		background = {
			margin = { 35 10 }
			size = { 100% 36 }
			visible = "[TradeMarketIcon.ShowEntrepotIcon]"
			texture = "gfx/interface/icons/banners/market_banner_red.dds"
			spriteborder = { 72 0 }
			spriteborder_right = 114
			texture_density = 4
		}

		background = {
			margin = { 35 10 }
			size = { 100% 36 }
			visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), Not( TradeMarketIcon.ShowEntrepotIcon ) )]"
			texture = "gfx/interface/icons/banners/market_banner_purple.dds"
			spriteborder = { 72 0 }
			spriteborder_right = 114
			texture_density = 4
		}

		background = {
			margin = { 35 10 }
			size = { 100% 36 }
			visible = "[And3( Or( And( TradeMarketIcon.HasBuyPaymentForFocusedGood, Not( TradeMarketIcon.HasSellPaymentForFocusedGood ) ), And3( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.HasPlayerRouteBuys, Not( TradeMarketIcon.HasPlayerRouteSells ) ) ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.ShowEntrepotIcon ) )]"
			texture = "gfx/interface/icons/banners/market_banner_blue.dds"
			spriteborder = { 72 0 }
			spriteborder_right = 114
			texture_density = 4
		}

		background = {
			margin = { 35 10 }
			size = { 100% 36 }
			visible = "[And3( Or( And( TradeMarketIcon.HasSellPaymentForFocusedGood, Not( TradeMarketIcon.HasBuyPaymentForFocusedGood ) ), And3( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.HasPlayerRouteSells, Not( TradeMarketIcon.HasPlayerRouteBuys ) ) ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( TradeMarketIcon.ShowEntrepotIcon ) )]"
			texture = "gfx/interface/icons/banners/market_banner_yellow.dds"
			spriteborder = { 72 0 }
			spriteborder_right = 114
			texture_density = 4
		}

		background = {
			margin = { 35 10 }
			size = { 100% 36 }
			visible = "[And4( Not( TradeMarketIcon.ShowEntrepotIcon ), Not( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ) ), Not( Or( And( TradeMarketIcon.HasBuyPaymentForFocusedGood, Not( TradeMarketIcon.HasSellPaymentForFocusedGood ) ), And3( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.HasPlayerRouteBuys, Not( TradeMarketIcon.HasPlayerRouteSells ) ) ) ), Not( Or( And( TradeMarketIcon.HasSellPaymentForFocusedGood, Not( TradeMarketIcon.HasBuyPaymentForFocusedGood ) ), And3( Not( TradeMarketIcon.HasFocusedGood ), TradeMarketIcon.HasPlayerRouteSells, Not( TradeMarketIcon.HasPlayerRouteBuys ) ) ) ) )]"
			texture = "gfx/interface/icons/banners/market_banner_green.dds"
			spriteborder = { 72 0 }
			spriteborder_right = 114
			texture_density = 4
		}

		expand = {}

		hbox = {
			datacontext = "[TradeMarketIcon.GetFocusedGood]"
			ignoreinvisible = yes
			margin_bottom = 3

			hbox = {
				margin_bottom = 2

				background = {
					texture = "gfx/interface/icons/banners/market_banner_decoration_red.dds"
					margin = { 3 8 }
					margin_top = 9
					visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), TradeMarketIcon.ShowEntrepotIcon )]"
				}
				background = {
					texture = "gfx/interface/icons/banners/market_banner_decoration_purple.dds"
					margin = { 3 8 }
					margin_top = 9
					visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), Not( TradeMarketIcon.ShowEntrepotIcon ) )]"
				}

				icon = {
					name = "realm_capital_icon"
					visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), Not( GetPlayer.IsLandlessRuler ) )]"
					size = { 22 22 }
					texture = "gfx/interface/icons/flat_icons/go_to_my_capital.dds"
					framesize = { 60 60 }
					frame = 2
					tooltip = "REALM_CAPITAL_IN_MARKET_TOOLTIP"
					using = tooltip_se

					modify_texture = {
						texture = "gfx/interface/colors/blue.dds"
					}
				}

				icon = {
					name = "domicile_icon"
					visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), GetPlayer.IsLandlessRuler )]"
					size = { 20 20 }
					texture = "[GetPlayer.GetDomicile.GetType.GetIcon]"
					tooltip = "DOMICILE_IN_MARKET_TOOLTIP"
					using = tooltip_se

					modify_texture = {
						texture = "gfx/interface/colors/blue.dds"
					}
				}
				spacer = {
					visible = "[And( ObjectsEqual( TradeMarket.Self, GetPlayer.GetCapitalLocation.GetTradeMarket ), GetPlayer.IsLandlessRuler )]"
					size = { 1 0 }
				}

			}

			spacer = {
				size = { 2 0 }
			}

			button_round = {
				size = { 28 28 }
				tooltip = "CLICK_TO_VIEW_MARKET"
				using = tooltip_se
				using = TradeMarket_Mouse_Entry

				onclick = "[ToggleGameViewData( 'trade_market_window', TradeMarket.Self )]"

				button_icon = {
					size = { 16 16 }
					parentanchor = center
					texture = "gfx/interface/icons/flat_icons/map_modes/trade_markets.dds"
					alwaystransparent = yes
				}
			}

			spacer = {
				size = { 2 0 }
			}

			text_single = {
				margin = { 5 5 }
				text = "[TradeMarket.GetShortNameNoTooltip]"
				align = nobaseline|left
				snap_to_pixels = no
				default_format = "#high"
			}

			spacer = {
				size = { 28 28 }
			}

			tooltipwidget = trade_market_map_icon_tooltip
		}

		expand = {}
	}


	type button_group_court_language_data = button_group
	{
		onclick = "[OpenGameViewData( 'language', CulturePillar.Self )]"
		tooltip = "COURT_LANGUAGE_OPEN_VIEW_TOOLTIP"

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 20 0 }
			margin_bottom = 5


			background = {
				using = Background_Area_Dark
				alpha = 0.9

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_edges.dds"
					blend_mode = alphamultiply
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 5 0 }

				text_label_center = {
					text = "COURT_LANGUAGE_NAME"
					default_format = "#high"
					using = Font_Size_Medium
					layoutpolicy_horizontal = expanding
					align = center
				}
			}

			text_single = {
				text = "IS_NATIVE_LANGUAGE"
				visible = "[ObjectsEqual( Culture.GetLanguage, CulturePillar.Self )]"
			}

			hbox = {
				margin_left = -4
				icon_culture_pillar = {
					name = "grandeur_icon"
					texture = "gfx/interface/window_roco_grandeur/icon_grandeur.dds"
					size = { 40 40 }
				}
				text_grandeur_from_language = {
					margin_bottom = 8
				}
			}
		}
	}

	type animations_map_coa = widget {
		size = { 10 10 }

		icon = {
			name = "at_war_anim"
			visible = "[CapitalMapIcon.IsAtWarWithMe]"

			parentanchor = center
			texture = "gfx/interface/icons/map_coa/at_war_icon.dds"
			size = { 95% 95% }

			modify_texture = {
				name = anim_mask1
				texture = "gfx/interface/icons/map_coa/at_war_mask.dds"
				blend_mode = alphamultiply

			}

			modify_texture = {
				name = anim_mask2
				texture = "gfx/interface/icons/map_coa/at_war_mask.dds"
				blend_mode = alphamultiply
			}

			modify_texture = {
				name = overlay
				texture = "gfx/interface/icons/map_coa/at_war_effect.dds"
				blend_mode = colordodge
			}

			state = {
				name = a
				next = b
				duration = 0.0
				trigger_on_create = yes

				modify_texture = {
					name = anim_mask1
					translate_uv = {0 0 }
				}

				modify_texture = {
					name = anim_mask2
					translate_uv = {0 -1 }
				}
			}

			state = {
				name = b
				next = a
				duration = 10

				modify_texture = {
					name = anim_mask1
					translate_uv = {0 1 }
				}

				modify_texture = {
					name = anim_mask2
					translate_uv = {0 0 }
				}
			}

			state = {
				trigger_on_create = yes
				name = start
				next = right

				duration = 0.0

				modify_texture = {
					name = overlay
					translate_uv = {0 0 }
				}
			}

			state = {
				name = right
				next = left

				duration = 7

				modify_texture = {
					name = overlay
					translate_uv = {0 1 }
				}
			}

			state = {
				name = left
				next = right
				duration = 0.0
				delay = 0

				modify_texture = {
					name = overlay
					translate_uv = {0 -0.6 }
				}
			}
		}

		icon = {
			name = "ally_war_anim"

			block "visible_ally" {
				visible = "[CapitalMapIcon.IsMyAllyInWar]"
			}

			parentanchor = center
			texture = "gfx/interface/icons/map_coa/ally_icon.dds"
			size = { 100% 100% }

			modify_texture = {
				name = overlay
				texture = "gfx/interface/icons/map_coa/ally_effect.dds"
				blend_mode = colordodge
				rotate_uv = 0
			}

			state = {
				name = right
				next = left

				duration = 15

				modify_texture = {
					name = overlay
					rotate_uv = 360
				}
			}

			state = {
				name = left
				next = right

				duration = 0
				delay = 0


				modify_texture = {
					name = overlay
					rotate_uv = 0
				}
			}

			state = {
				trigger_on_create = yes
				name = start
				next = right

				duration = 0.0

				modify_texture = {
					name = overlay
					rotate_uv = 0
				}
			}

			modify_texture = {
				name = overlay2
				texture = "gfx/interface/icons/map_coa/ally_effect.dds"
				blend_mode = colordodge
				rotate_uv = 0
			}

			state = {
				name = right2
				next = left2

				duration = 15

				modify_texture = {
					name = overlay2
					rotate_uv = -360
				}
			}

			state = {
				name = left2
				next = right2

				duration = 0
				delay = 0


				modify_texture = {
					name = overlay2
					rotate_uv = 0
				}
			}

			state = {
				trigger_on_create = yes
				name = start
				next = right

				duration = 0.0

				modify_texture = {
					name = overlay2
					rotate_uv = 0
				}
			}
		}
	}

	type coa_realm_map_big = widget {
		size = { 70 110 }

		container = {
			parentanchor = center
			scale = 1

			state = {
				name = "map_zoom_close"
				scale = 1
				duration = 0.25
				trigger_when = "[LessThan_int32( GetZoomLevel, '(int32)14' )]"
			}

			state = {
				name = "map_zoom_far"
				scale = 0.8
				duration = 0.25
				trigger_when = "[GreaterThan_int32( GetZoomLevel, '(int32)13' )]"
			}

			animations_map_coa = {
				name = "animations"
				parentanchor = center
				position = { 0 -35 }
				size = { 120 110 }
			}

			icon = {
				name = "ally_war_icon"
				visible = "[CapitalMapIcon.IsMyAlly]"
				parentanchor = center
				position = { -8 -30 }

				size = { 72 78 }
				texture = "gfx/interface/icons/map_coa/icon_ally.dds"
			}

			icon = {
				name = "at_war_icon"
				visible = "[CapitalMapIcon.IsAtWarWithMe]"
				parentanchor = center
				position = { 0 -20 }
				size = { 80 80 }
				texture = "gfx/interface/icons/map_coa/icon_at_war_big.dds"
			}


			icon = {
				name = "player_icon"
				visible = "[CapitalMapIcon.GetOwner.IsPlayer]"

				texture = "gfx/interface/icons/map_coa/icon_player.dds"
				framesize = { 156 156 }
				frame = 4

				position = { 0 -6 }
				size = { 100 100 }
				parentanchor = center
			}

			coa_realm_medium_crown = {
				parentanchor = center
			}

			### Tributary Icon
			widget = {
				visible = "[Character.HasSuzerain]"
				visible_at_creation = no
				parentanchor = bottom|hcenter
				position = { 20 -7 }
				size = { 24 24 }

				icon = {
					name = "tributary_settled"
					visible = "[And( Not( IsNomad( Character )), Not( IsHerder( Character ) ) )]"
					parentanchor = center
					size = { 24 24 }
					texture = "gfx/interface/icons/tributary_settled_map_icon.dds"
				}

				icon = {
					name = "tributary_nomadic"
					visible = "[Or(IsNomad( Character ), IsHerder( Character ))]"
					parentanchor = center
					size = { 24 24 }
					texture = "gfx/interface/icons/tributary_nomadic_map_icon.dds"
				}
			}

			widget = {
				visible = "[And( Character.GetConfederation.IsValid, And( ObjectsEqual( Character.GetConfederation, GetPlayer.GetConfederation ), Not( Character.IsLocalPlayer ) ) )]"
				visible_at_creation = no
				parentanchor = bottom|hcenter
				position = { -20 -7 }
				size = { 24 24 }

				icon = {
					name = "same_bloc"
					visible = "[Character.GetConfederation.IsHouseBasedConfederation]"
					parentanchor = center
					size = { 24 24 }
					texture = "gfx/interface/icons/same_bloc_map_icon.dds"
					tooltip = "REALM_FLAG_SAME_BLOC"
					using = tooltip_below
				}

				icon = {
					name = "same_confederation"
					visible = "[Not( Character.GetConfederation.IsHouseBasedConfederation )]"
					parentanchor = center
					size = { 24 24 }
					texture = "gfx/interface/icons/same_confederation_map_icon.dds"
					tooltip = "REALM_FLAG_SAME_CONFEDERATION"
					using = tooltip_below
				}
			}

			### Cardinal Icon
			flowcontainer = {
				datamodel = "[Character.GetTitles]"

				ignoreinvisible = yes
				parentanchor = bottom|right
				position = { -24 -4 }

				item = {
					icon = {
						visible = "[Title.HasClericalElector]"
						size = { 24 24 }
						texture = "gfx/interface/icons/cardinal_ruler_map_icon.dds"

						background = {
							using = Background_Area_Dark
							alpha = 0.8
							margin = { 5 5 }

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_circle.dds"
								blend_mode = alphamultiply
							}
						}

						glow = {
							color = { 0 0 0 1 }
							glow_radius = 1
							alpha = 0.8

							using = Glow_Standard_Thin
						}
					}
				}
			}
		}
	}

