### Clerical Region Elector Map Icon
container = {
	name = "clerical_region_elector_icon"
	datacontext = "[ClericalRegionElectorIcon.GetTitle]"
	widgetanchor = center
	ignoreinvisible = yes
	allow_outside = yes
	scale = 1

	state = {
		name = "map_zoom_close"
		scale = 1
		duration = 0.25
		trigger_when = "[LessThan_int32( GetZoomLevel, '(int32)14' )]"
	}

	state = {
		name = "map_zoom_far"
		scale = 0.8
		duration = 0.25
		trigger_when = "[GreaterThan_int32( GetZoomLevel, '(int32)13' )]"
	}

	using = tooltip_es
	tooltip_offset = { 10 0 }

	container = {
		visible = "[Or( Title.HasClericalElector, Title.HasClericalRegion )]"

		coa_title_small_crown  = {}
	}

	### Rite Icon
	religious_head_map_icon = {
		blockoverride "icon_visible" {
			visible = "[Title.HasHolder]"
		}
		blockoverride "icon_datacontext" {
			datacontext = "[Title.GetHolder.GetRite]"
		}
		blockoverride "icon_texture" {
			texture = "[Rite.GetIcon]"
		}
		blockoverride "icon_tooltip" {
			tooltipwidget = { rite_tooltip = {} }
		}
	}

}

### clerical region converting county Icon
container = {
	name = "clerical_region_conversion_progress_icon"
	datacontext = "[ClericalRegionConversionProgressIcon.GetClericalRegionTitle]"
	widgetanchor = center
	ignoreinvisible = yes
	allow_outside = yes

	tooltip = "FAITHS_MAP_MODE_CONVERSION_WIDGET_TOOLTIP"

	icon = {
		texture = "gfx/interface/icons/activity_phases/button_activity_base.dds"
		size = { 48 48 }
	}

	icon = {
		texture = "[ClericalRegionConversionProgressIcon.GetConversionRite.GetIcon]"
		size = { 32 32 }
		alwaystransparent = yes
		widgetanchor = center
		parentanchor = center
	}

	progresspie = {
		size = { 90% 90% }
		texture = "gfx/interface/progressbars/action_progress_thin.dds"
		framesize = { 128 128 }
		frame = 2
		value = "[ClericalRegionConversionProgressIcon.GetConversionProgress]"
