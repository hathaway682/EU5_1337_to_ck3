types gen_debug_panel {
	type gen_debug_panel_host = window {
		name = "gen_debug_panel_host"
		allow_outside = yes
		parentanchor = center
		size = { 0 0 }

		visible = "[And( InDebugMode, And( Not( IsPauseMenuShown ), IsDefaultGUIMode ) )]"

		widget = {
			size = { 0 0 }
			allow_outside = yes
			visible = "[GetPlayer.IsValid]"
			gen_debug_panel_window = {}
		}

		widget = {
			size = { 0 0 }
			allow_outside = yes
			visible = "[Not( GetPlayer.IsValid )]"
			gen_debug_panel_window_obs = {}
		}
	}

