	type gen_debug_panel_window_obs = window {
		name = "gen_debug_panel_window_obs"
		allow_outside = yes
		movable = yes
		parentanchor = center
		position = { 0 -40 }
		size = { 770 720 }
		using = Window_Background
		using = Window_Decoration_Spike

		visible = "[GetVariableSystem.Exists( 'gen_debug_panel_observer_open' )]"

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_start = "[GetScriptedGui('gen_debug_panel_gather_obs').Execute( GuiScope.SetRoot( GetTitleByKey( 'c_gen_buamu_4' ).MakeScope ).End )]"
			on_start = "[GetVariableSystem.Set( 'gen_debug_tab', 'world' )]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			using = Window_Margins

			header_standard = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "GEN_DEBUG_PANEL_TITLE_OBSERVER"
				}

				blockoverride "button_close" {
					onclick = "[GetVariableSystem.Clear( 'gen_debug_panel_observer_open' )]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				margin_bottom = 6
				button_standard = {
					size = { 150 30 }
					text = "GEN_DEBUG_PANEL_TAB_WORLD"
					onclick = "[GetVariableSystem.Set( 'gen_debug_tab', 'world' )]"
					down = "[GetVariableSystem.HasValue( 'gen_debug_tab', 'world' )]"
					alwaystransparent = "[GetVariableSystem.HasValue( 'gen_debug_tab', 'world' )]"
				}
				button_standard = {
					size = { 150 30 }
					text = "GEN_DEBUG_PANEL_TAB_REALM"
					onclick = "[GetVariableSystem.Set( 'gen_debug_tab', 'realm' )]"
