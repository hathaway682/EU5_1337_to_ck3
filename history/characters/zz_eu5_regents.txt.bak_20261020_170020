alb_charles_durazzo = {
	1337.1.1 = {
		effect = {
			character:alb_agnes_perigord = {
				set_employer = character:alb_charles_durazzo
			}
			designate_diarch = alb_agnes_perigord
			try_start_diarchy = regency
		}
	}
}
